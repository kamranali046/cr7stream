@model List<ZeroSports.Logic.Models.Match>
@{
    ViewData["Title"] = "Search";
    var query = (string?)ViewData["Query"] ?? string.Empty;
}

<section class="search-page container">
    <h1 class="search-title">Search @(string.IsNullOrWhiteSpace(query) ? "" : $"&ldquo;{query}&rdquo;")</h1>

    <form class="search-form" asp-controller="Search" asp-action="Find" method="get" role="search">
        <input type="search" name="q" value="@query" placeholder="Search games, teams, leagues..." aria-label="Search games" autocomplete="off" />
        <button type="submit">Search</button>
    </form>

    @if (string.IsNullOrWhiteSpace(query))
    {
        <p class="search-hint">Type a team, league or sport to find live and upcoming streams.</p>
    }
    else if (Model.Count == 0)
    {
        <p class="search-hint">No matches found for &ldquo;@query&rdquo;.</p>
    }
    else
    {
        <p class="search-count">@Model.Count match(es) found</p>
        <div class="match-list">
            @foreach (var match in Model)
            {
                <partial name="_MatchCard" model="match" />
            }
        </div>
    }
</section>
