@model ZeroSports.Logic.CategoryInput
@{
    ViewData["Title"] = "Add Category";
}

<div class="admin-card" style="max-width:480px;">
    <h3 class="mb-3">Add Category</h3>
    <form asp-action="CategoryCreate" method="post" class="admin-form">
        <div class="mb-3">
            <label asp-for="Name">Category name</label>
            <input asp-for="Name" class="form-control" placeholder="e.g. Premier League" />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Sport">Sport (optional)</label>
            <input asp-for="Sport" class="form-control" placeholder="e.g. Football" />
            <small style="color:var(--muted);">Used for grouping. Leave blank to use the category name.</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-danger" type="submit">Create</button>
            <a class="btn btn-outline-light" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>
