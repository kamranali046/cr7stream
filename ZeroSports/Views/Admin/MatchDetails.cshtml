@model ZeroSports.Logic.Models.Match
@{
    ViewData["Title"] = "Match Players";
    var live = Model.IsLive || Model.Status == "live";
    var ended = Model.IsEnded || Model.Status == "replay";
}

<div class="admin-card" style="max-width:900px;">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h3 class="mb-1">
                @Model.HomeTeam <span style="color:var(--muted);">vs</span> @Model.AwayTeam
                @if (live) { <span class="admin-badge live">LIVE</span> }
                else if (ended) { <span class="admin-badge replay">ENDED</span> }
                @if (Model.Important) { <span class="admin-badge important">&#9733;</span> }
            </h3>
            <div class="cat-meta">league: @Model.LeagueSlug · @Model.StartTimeUtc.AddHours(5).ToString("dd-MMM-yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) PKT</div>
        </div>
        <a class="btn btn-sm btn-outline-light" asp-action="Index">&#8592; Back to dashboard</a>
    </div>

    <div class="d-flex gap-2 flex-wrap mt-2">
        <form asp-action="ToggleMatchLive" asp-route-slug="@Model.Slug" method="post" class="d-inline" title="Mark as live">
            <label class="tick">
                <input type="checkbox" @(live ? "checked" : "") onchange="this.form.submit()" /> Live
            </label>
        </form>
        <form asp-action="ToggleMatchEnded" asp-route-slug="@Model.Slug" method="post" class="d-inline" title="Mark as ended">
            <label class="tick">
                <input type="checkbox" @(ended ? "checked" : "") onchange="this.form.submit()" /> Ended
            </label>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.SourceUrl))
    {
        <p class="mt-2 mb-0">
            <strong>Match link:</strong>
            <a href="@Model.SourceUrl" target="_blank" style="color:var(--accent);">@Model.SourceUrl</a>
            <form asp-action="RefreshPlayers" asp-route-slug="@Model.Slug" method="post" class="d-inline">
                <button class="btn btn-sm btn-warning" type="submit">Refresh players from source</button>
            </form>
        </p>
    }

    <h4 class="mt-3 mb-2">Players (@Model.Players.Count)</h4>

    @if (Model.Players.Count == 0)
    {
        <p style="color:var(--muted);">No players yet. Use <strong>Refresh players from source</strong> (available when the match is close to kickoff) or add one manually below.</p>
    }
    else
    {
        <table class="admin-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Name</th>
                    <th>URL</th>
                    <th>On/Off</th>
                    <th>Order</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Model.Players.Count; i++)
                {
                    var player = Model.Players[i];
                    <tr class="@(!player.Enabled ? "opacity-50" : "")">
                        <td>@(i + 1)</td>
                        <td>@player.Name</td>
                        <td style="max-width:320px;word-break:break-all;">@player.Url</td>
                        <td>
                            <form asp-action="TogglePlayer" asp-route-slug="@Model.Slug" method="post" class="d-inline">
                                <input type="hidden" name="index" value="@i" />
                                <button class="btn btn-sm btn-outline-light" type="submit">@(player.Enabled ? "On" : "Off")</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="MovePlayer" asp-route-slug="@Model.Slug" method="post" class="d-inline">
                                <input type="hidden" name="index" value="@i" />
                                <input type="hidden" name="direction" value="up" />
                                <button class="btn btn-sm btn-outline-light" type="submit" title="Move up">&#9650;</button>
                            </form>
                            <form asp-action="MovePlayer" asp-route-slug="@Model.Slug" method="post" class="d-inline">
                                <input type="hidden" name="index" value="@i" />
                                <input type="hidden" name="direction" value="down" />
                                <button class="btn btn-sm btn-outline-light" type="submit" title="Move down">&#9660;</button>
                            </form>
                        </td>
                        <td>
                            <form asp-action="SavePlayer" asp-route-slug="@Model.Slug" method="post" class="d-flex gap-1 mb-1">
                                <input type="hidden" name="index" value="@i" />
                                <input type="text" name="url" value="@player.Url" class="form-control form-control-sm" style="max-width:260px;" />
                                <button class="btn btn-sm btn-outline-light" type="submit">Save</button>
                            </form>
                            <form asp-action="DeletePlayer" asp-route-slug="@Model.Slug" method="post" class="d-inline" onsubmit="return confirm('Delete this player?');">
                                <input type="hidden" name="index" value="@i" />
                                <button class="btn btn-sm btn-outline-danger" type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <h4 class="mt-3 mb-2">Add player</h4>
    <form asp-action="AddPlayer" asp-route-slug="@Model.Slug" method="post" class="admin-form d-flex gap-2 flex-wrap align-items-end">
        <div>
            <label>Name (optional)</label>
            <input name="name" class="form-control" placeholder="Player N" />
        </div>
        <div>
            <label>Stream URL</label>
            <input name="url" class="form-control" placeholder="https://..." required />
        </div>
        <button class="btn btn-danger" type="submit">Add player</button>
    </form>
</div>
