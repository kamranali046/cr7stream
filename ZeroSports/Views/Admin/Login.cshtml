@model ZeroSports.Models.LoginViewModel
@{
    ViewData["Title"] = "Admin Login";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-login-wrap admin-card">
    <h3 class="mb-3">Admin Login</h3>
    <form asp-action="Login" method="post">
        <div class="admin-form mb-3">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" class="form-control" autocomplete="username" />
        </div>
        <div class="admin-form mb-3">
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" />
        </div>
        <div asp-validation-summary="All" class="text-danger mb-2"></div>
        <button class="btn btn-danger w-100" type="submit">Login</button>
    </form>
    <p class="mt-3 mb-0" style="color:var(--muted);font-size:12px;">
        Default credentials: <strong>admin</strong> / <strong>admin123</strong> (set in appsettings.json).
    </p>
</div>
