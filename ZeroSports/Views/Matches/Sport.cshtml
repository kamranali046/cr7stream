@model ZeroSports.Logic.Models.SportPageViewModel
@{
    ViewData["Title"] = (Model.Sport?.Name ?? "Sport") + " Streams - CR7Stream";
}

<p><a class="back-link" asp-controller="Home" asp-action="Index">&larr; Back to Homepage</a></p>

<h2 class="section-title">@Model.Sport?.Name Live & Upcoming</h2>

@if (Model.ImportantMatches.Any())
{
    <section class="league-section important-section">
        <div class="league-head">
            <span class="badge-important" title="Important">&#9733;</span>
            <h3>@Categories.ImportantMatchesName</h3>
        </div>
        <div class="match-list">
            @foreach (var match in Model.ImportantMatches)
            {
                await Html.RenderPartialAsync("_MatchCard", match);
            }
        </div>
    </section>
}

@if (Model.Matches.Any())
{
    <section class="league-section">
        <div class="league-head"><h3>@Model.Sport?.Name</h3></div>
        <div class="match-list">
            @foreach (var match in Model.Matches)
            {
                await Html.RenderPartialAsync("_MatchCard", match);
            }
        </div>
    </section>
}
else
{
    <p class="muted">No matches scheduled right now.</p>
}
