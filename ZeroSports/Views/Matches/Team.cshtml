@model ZeroSports.Logic.Models.TeamPageViewModel
@{
    ViewData["Title"] = (Model.Team?.Name ?? "Team") + " Fixtures - ZeroSports";
}

<p><a class="back-link" asp-controller="Home" asp-action="Index">&larr; Back to all sports</a></p>

<div class="team-head">
    <img src="@(string.IsNullOrEmpty(Model.Team?.Logo) ? "/img/match-placeholder.svg" : Model.Team!.Logo)" alt="@Model.Team?.Name" width="56" height="56" onerror="this.onerror=null;this.src='/img/match-placeholder.svg'" />
    <h2 class="section-title">@Model.Team?.Name Fixtures</h2>
</div>

@if (Model.Matches.Any())
{
    <div class="match-list">
        @foreach (var match in Model.Matches)
        {
            await Html.RenderPartialAsync("_MatchCard", match);
        }
    </div>
}
else
{
    <p class="muted">No matches scheduled for this team right now.</p>
}
