@model List<ZeroSports.Logic.Models.Sport>

<header class="site-header">
    <div class="container-fluid">
        <div class="header-row">
            <a class="brand" asp-controller="Home" asp-action="Index">Zero<span>Sports</span></a>
            <nav id="mainNav" class="main-nav">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" && ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")"
                   asp-controller="Home" asp-action="Index">HOME</a>
                <a class="nav-link @(ViewContext.RouteData.Values["sport"]?.ToString() == "football" ? "active" : "")" asp-controller="Matches" asp-action="Sport" asp-route-sport="football"><svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v18M3 12h18" stroke="currentColor" stroke-width="1.1"/></svg> Football</a>
                <a class="nav-link @(ViewContext.RouteData.Values["sport"]?.ToString() == "basketball" ? "active" : "")" asp-controller="Matches" asp-action="Sport" asp-route-sport="basketball"><svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M12 3v18" stroke="currentColor" stroke-width="1.1"/><path d="M3 9c3 2 15 2 18 0M3 15c3-2 15-2 18 0" fill="none" stroke="currentColor" stroke-width="1.1"/></svg> NBA</a>
                <a class="nav-link @(ViewContext.RouteData.Values["sport"]?.ToString() == "nfl" ? "active" : "")" asp-controller="Matches" asp-action="Sport" asp-route-sport="nfl"><svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="12" rx="10" ry="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="M9 12h6M10.5 10.3v3.4M12 10.3v3.4M13.5 10.3v3.4" stroke="currentColor" stroke-width="1"/></svg> NFL</a>
                <a class="nav-link @(ViewContext.RouteData.Values["sport"]?.ToString() == "motorsport" ? "active" : "")" asp-controller="Matches" asp-action="Sport" asp-route-sport="motorsport"><svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3v18" stroke="currentColor" stroke-width="1.6"/><path d="M6 4h12l-3 4 3 4H6z" fill="none" stroke="currentColor" stroke-width="1.4"/></svg> F1</a>
                <a class="nav-link @(ViewContext.RouteData.Values["sport"]?.ToString() == "wwe" ? "active" : "")" asp-controller="Matches" asp-action="Sport" asp-route-sport="wwe"><svg class="nav-ico" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 11V7a2 2 0 0 1 4 0v3m0-1a2 2 0 0 1 4 0v1m0 0a2 2 0 0 1 4 0v4a5 5 0 0 1-5 5h-2a5 5 0 0 1-5-5v-3" fill="none" stroke="currentColor" stroke-width="1.4"/></svg> UFC</a>
            </nav>
            <div class="header-tools">
                <form class="nav-search" asp-controller="Search" asp-action="Find" method="get" role="search">
                    <input type="search" name="q" placeholder="Search games..." aria-label="Search games" autocomplete="off" />
                </form>
                <button id="themeToggle" class="theme-toggle" type="button" aria-label="Toggle light / dark theme" title="Toggle light / dark theme">
                    <span class="theme-label">Dark Theme</span>
                    <span id="themeIcon">&#9728;</span>
                </button>
                <button class="nav-toggle" type="button" onclick="document.getElementById('mainNav').classList.toggle('open')">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>
    </div>
</header>
