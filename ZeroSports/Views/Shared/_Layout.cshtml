<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CR7Stream</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "CR7Stream - Watch free live sports streams for Football, UFC, Boxing, F1, NBA, NFL, NHL and more. HD links, instant access, no signup required.")" />
    <meta name="keywords" content="live sports streams, free sports streaming, football live stream, UFC stream, NBA stream, NFL stream, F1 live, watch sports online, boxing stream, hockey stream" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"] - CR7Stream" />
    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Watch free HD live sports streams - Football, UFC, Boxing, F1, NBA, NFL, NHL. No signup, instant access.")" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://cr7stream.com/" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="theme-color" content="#0b0e14" />
    <meta property="og:image" content="https://cr7stream.com/logo.png" />
    <script>
        (function () {
            var t = localStorage.getItem('theme');
            if (t === 'light') document.documentElement.setAttribute('data-theme', 'light');
        })();
    </script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @await Component.InvokeAsync("MainNav")

    <main class="container site-body">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <p class="footer-networks">
                <strong>Explore Our Streaming Networks:</strong>
                <a href="https://totalsportek.st/" target="_blank">TOTALSPORTEK</a> |
                <a href="https://sportsurge.st/" target="_blank">SPORTSURGE</a> |
                <a href="https://buffstreamss.sx/" target="_blank">BUFFSTREAM</a> |
                <a href="https://crackstreamss.sx/" target="_blank">CRACKSTREAMS</a> |
                <a href="https://nflbites.st/" target="_blank">NFLBITE</a>
            </p>
            <p class="footer-copy">&copy; 2026 CR7Stream. All Rights Reserved. Always free, no signup needed.</p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/countdown.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
