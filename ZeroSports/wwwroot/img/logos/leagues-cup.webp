    .ts-telegram-alert-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1E96C8, #0C6C9C);
    color: #ffffff;
    text-decoration: none;
    padding: 16px 24px;
    border-radius: 8px;
    border: 2px solid #2AABEE;
    width: 100%;
    box-sizing: border-box;
    gap: 20px;
    transition: all 0.3s ease;
    animation: ts-pulse-glow 2s infinite;
    margin-bottom: 20px;
}

.ts-telegram-alert-btn:hover {
    transform: scale(1.02);
    background: linear-gradient(135deg, #2AABEE, #1682B8);
    text-decoration: none;
    color: #ffffff;
}

.ts-tg-icon {
    display: flex;
    align-items: center;
    filter: drop-shadow(0 2px 5px rgba(0,0,0,0.4));
}

.ts-tg-content {
    display: flex;
    flex-direction: column;
    text-align: left;
}

.ts-tg-main {
    font-size: 18px;
    font-weight: 600;
    line-height: 1.3;
    font-family: Arial, sans-serif;
}

.ts-tg-highlight {
    color: #FFD700; /* High-visibility yellow */
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.ts-tg-sub {
    font-size: 15px;
    font-weight: 800;
    background: #ffffff;
    color: #0C6C9C;
    padding: 3px 10px;
    border-radius: 4px;
    display: inline-block;
    margin-top: 6px;
    width: fit-content;
    text-transform: uppercase;
}

/* Attention-Grabbing Animation */
@keyframes ts-pulse-glow {
    0% { box-shadow: 0 0 0 0 rgba(42, 171, 238, 0.7); }
    70% { box-shadow: 0 0 0 15px rgba(42, 171, 238, 0); }
    100% { box-shadow: 0 0 0 0 rgba(42, 171, 238, 0); }
}

/* Mobile Responsiveness */
@media (max-width: 768px) {
    .ts-telegram-alert-btn {
        flex-direction: column;
        text-align: center;
        gap: 10px;
        padding: 12px 15px;
    }
    .ts-tg-content {
        align-items: center;
        text-align: center;
    }
    .ts-tg-main {
        font-size: 16px;
    }
}
</style>





