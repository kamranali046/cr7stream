    <!-- header start -->
    <style>
    /* =========================================
       PREMIUM NAVBAR UPGRADE
       ========================================= */
    header.site-header {
        background-color: #0b0e14 !important;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05) !important;
        position: sticky;
        top: 0;
        z-index: 9999;
    }

    header.site-header .navbar {
        background: transparent !important;
        padding: 0.5rem 0;
    }

    /* Gradient Brand Logo */
    .brand-logo-custom {
        font-weight: 900 !important;
        font-size: 1.75rem !important;
        letter-spacing: 1px;
        text-transform: uppercase;
        background: linear-gradient(135deg, #ff8a00, #ffc837);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        text-decoration: none !important;
        transition: transform 0.3s ease;
        display: inline-block;
    }
    .brand-logo-custom:hover {
        transform: scale(1.02);
    }

    /* Nav Links */
    .navbar-nav .nav-link {
        color: #8b949e !important;
        font-size: 12px !important;
        font-weight: 700 !important;
        letter-spacing: 1px;
        text-transform: uppercase !important;
        transition: color 0.2s ease;
        padding: 12px 14px !important;
    }
    .navbar-nav .nav-link:hover {
        color: #ffffff !important;
    }

    /* Desktop Dropdown Menus */
    .dropdown {
        position: relative;
        display: inline-block;
    }
    .dropdown-content {
        display: none;
        position: absolute;
        background: linear-gradient(145deg, #161b22, #10141a) !important;
        min-width: 220px;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-top: 2px solid #ff8a00;
        border-radius: 0 0 10px 10px;
        box-shadow: 0 15px 35px rgba(0,0,0,0.7);
        z-index: 1000;
        padding: 8px 0;
    }
    .dropdown-content a {
        color: #c9d1d9 !important;
        padding: 10px 18px;
        font-size: 12px;
        font-weight: 600;
        text-decoration: none;
        display: block;
        transition: all 0.2s ease;
    }
    .dropdown-content a:hover {
        background: rgba(0, 198, 255, 0.08) !important;
        color: #00c6ff !important;
        padding-left: 22px;
    }
    .dropdown:hover .dropdown-content {
        display: block;
        animation: dropFadeIn 0.25s ease forwards;
    }

    @keyframes dropFadeIn {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* Mobile Drawer */
    @media screen and (max-width: 991px){
        .dropdown-content {
            position: static !important;
            background: rgba(0,0,0,0.3) !important;
            box-shadow: none;
            border: none;
            border-left: 2px solid #ff8a00;
            margin-left: 10px;
        }
        .navbar-collapse {
            background: #10141a;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid rgba(255,255,255,0.06);
            margin-top: 10px;
        }
    }
</style>

