   <style>



/* Base Global Theme - True Black & Charcoal */
body, body.dark {
    background-color: #050505 !important;
    background-image: radial-gradient(circle at top center, #1a0b05 0%, #050505 40%);
    color: #edf2f7 !important;
    font-family: 'Inter', system-ui, sans-serif;
    -webkit-font-smoothing: antialiased;
}

.div-child-box { border-bottom: 1px solid rgba(255, 78, 0, 0.1); }  

/* Flamy Match Cards */
.bg-game, .modern-match-card {
    background: rgba(18, 18, 18, 0.85) !important;
    border: 1px solid rgba(255, 255, 255, 0.05) !important;
    border-left: 3px solid #ff4e00 !important;
    border-radius: 12px !important;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    margin-bottom: 10px;
    display: block;
    text-decoration: none !important;
}

.bg-game:hover, .modern-match-card:hover {
    background: rgba(25, 25, 25, 1) !important;
    border-color: rgba(255, 78, 0, 0.4) !important;
    border-left: 4px solid #e52d27 !important;
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(255, 78, 0, 0.15);
}

/* Tournament Headers */
.top-tournament, .league-header {
    background: linear-gradient(90deg, rgba(255, 78, 0, 0.15) 0%, rgba(15, 15, 15, 0.9) 40%, rgba(10, 10, 10, 0.4) 100%) !important;
    border: 1px solid rgba(255, 78, 0, 0.1) !important;
    border-left: 4px solid #ff4e00 !important;
    padding: 10px 16px !important;
    border-radius: 10px !important;
    margin-bottom: 15px;
    margin-top: 20px;
    display: flex;
    align-items: center;
}

.top-tournament h4, .league-header span {
    color: #ffffff !important;
    font-size: 15px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
}

.leagueimg {
    margin-right: 12px;
    width: 32px;
    height: 32px;
    object-fit: contain;
    filter: drop-shadow(0 2px 5px rgba(255,78,0,0.3));
}

/* Buttons & Badges */
.btn-live, .highlight {
    background: linear-gradient(135deg, #ff4e00, #e52d27) !important;
    color: #ffffff !important;
    border-radius: 6px !important;
    padding: 5px 14px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    text-transform: uppercase;
    box-shadow: 0 4px 15px rgba(255, 78, 0, 0.4);
    border: none;
    display: inline-block;
}

.btn-highlight {
    background: linear-gradient(135deg, #3f3f46, #27272a) !important;
    color: #d4d4d8 !important;
    border-radius: 6px !important;
    padding: 5px 14px !important;
    font-size: 11px !important;
    font-weight: 800 !important;
    text-transform: uppercase;
    border: 1px solid rgba(255,255,255,0.1);
}

/* Modern Sidebar & Blog Styles */
.sidebar-glass {
    background: rgba(18, 18, 18, 0.85);
    border: 1px solid rgba(255, 78, 0, 0.1);
    border-radius: 12px;
    padding: 20px 15px;
    margin-bottom: 20px;
    box-shadow: 0 8px 20px rgba(0,0,0,0.4);
}

.sidebar-header {
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    margin-bottom: 15px;
    padding-bottom: 10px;
}

.sidebar-title {
    color: #ffffff;
    font-size: 16px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
    border-left: 3px solid #ff4e00;
    padding-left: 10px;
}

.sidebar-list {
    list-style: none;
    margin: 0;
    padding: 0;
}

.sidebar-item a {
    display: flex;
    align-items: center;
    padding: 10px 12px;
    color: #a1a1aa;
    text-decoration: none !important;
    font-size: 13px;
    font-weight: 600;
    border-radius: 8px;
    transition: all 0.3s ease;
}

.sidebar-item a:hover {
    background: linear-gradient(90deg, rgba(255, 78, 0, 0.1) 0%, rgba(255, 78, 0, 0) 100%);
    color: #ff4e00;
    transform: translateX(5px);
}

.sidebar-item img {
    margin-right: 12px;
    object-fit: contain;
    filter: drop-shadow(0 2px 4px rgba(0,0,0,0.3));
}

.blog-card {
    background: rgba(10, 10, 10, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 15px;
    transition: all 0.3s ease;
}

.blog-card:hover {
    border-color: rgba(255, 78, 0, 0.3);
    transform: translateY(-3px);
    box-shadow: 0 6px 15px rgba(255, 78, 0, 0.15);
}

.blog-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-bottom: 2px solid #ff4e00;
}

.blog-card-title {
    color: #e4e4e7;
    font-size: 13px;
    font-weight: 600;
    padding: 12px;
    margin: 0;
    line-height: 1.4;
}

.view-all-btn {
    display: block;
    text-align: center;
    background: rgba(255, 255, 255, 0.05);
    color: #ff4e00;
    padding: 10px;
    border-radius: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none !important;
    transition: all 0.3s ease;
    margin-top: 10px;
}

.view-all-btn:hover {
    background: rgba(255, 78, 0, 0.1);
    color: #ffffff;
}

/* Nav links */
.nav-link2 {
    color: #a1a1aa !important;
    text-decoration: none !important;
    font-weight: 600;
    transition: color 0.2s ease;
}
.nav-link2:hover {
    color: #ff4e00 !important;
}


    </style>
</head>
