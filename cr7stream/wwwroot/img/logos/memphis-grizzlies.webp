<style>
    .pulse-text-flame {
        font-size: 18px;
        font-weight: 900;
        text-transform: uppercase;
        background: linear-gradient(to right, #ff4e00, #ffc837);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: 1px;
        margin: 0;
        animation: flame-pulse 2s infinite;
    }

    @keyframes flame-pulse {
        0% { filter: drop-shadow(0 0 2px rgba(255,78,0,0.4)); }
        50% { filter: drop-shadow(0 0 8px rgba(255,78,0,0.8)); }
        100% { filter: drop-shadow(0 0 2px rgba(255,78,0,0.4)); }
    }

    .match-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 12px;
    }

    .team-name {
        color: #F1F5F9;
        font-weight: 600;
        font-size: 14px;
        flex: 1;
        display: flex;
        align-items: center;
    }

    .team-left { justify-content: flex-end; text-align: right; }
    .team-right { justify-content: flex-start; text-align: left; }

    .team-logo {
        width: 24px;
        height: 24px;
        object-fit: contain;
        margin: 0 8px;
    }

    .match-center {
        flex: 0 0 110px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .match-time {
        color: #a1a1aa;
        font-size: 11px;
        font-weight: 600;
        margin-bottom: 6px;
    }

    @media screen and (max-width: 767px) {
        .team-name { font-size: 12px; }
        .match-center { flex: 0 0 90px; }
    }
</style>

<style>
    /* MATCH CARD FIX FOR SUBPAGES */
    .match-row { display: flex; align-items: center; justify-content: space-between; padding: 12px; }
    .team-name { color: #F1F5F9; font-weight: 600; font-size: 14px; flex: 1; display: flex; align-items: center; }
    .team-left { justify-content: flex-end; text-align: right; }
    .team-right { justify-content: flex-start; text-align: left; }
    .team-logo { width: 24px !important; height: 24px !important; object-fit: contain; margin: 0 8px; }
    .match-center { flex: 0 0 110px; text-align: center; display: flex; flex-direction: column; align-items: center; }
    .match-time { color: #a1a1aa; font-size: 11px; font-weight: 600; margin-bottom: 6px; text-align: center; line-height: 1.2; }
    @media screen and (max-width: 767px) {
        .team-name { font-size: 12px; }
        .match-center { flex: 0 0 90px; }
    }
</style>
