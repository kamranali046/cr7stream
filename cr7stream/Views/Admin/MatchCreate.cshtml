@model cr7stream.Logic.MatchInput
@{
    ViewData["Title"] = "Add Match";
    var category = ViewData["Category"] as cr7stream.Logic.Models.League;
}

<div class="admin-card" style="max-width:560px;">
    <h3 class="mb-1">Add Match</h3>
    <div class="cat-meta mb-3">Category: <strong>@category?.Name</strong></div>

    <form asp-action="MatchCreate" asp-route-categorySlug="@category?.Slug" method="post" class="admin-form">
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="HomeTeam">Home team</label>
                <input asp-for="HomeTeam" class="form-control" />
            </div>
            <div class="col-6 mb-3">
                <label asp-for="AwayTeam">Away team</label>
                <input asp-for="AwayTeam" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="HomeTeamLogo">Home logo URL (optional)</label>
                <input asp-for="HomeTeamLogo" class="form-control" />
            </div>
            <div class="col-6 mb-3">
                <label asp-for="AwayTeamLogo">Away logo URL (optional)</label>
                <input asp-for="AwayTeamLogo" class="form-control" />
            </div>
        </div>
        <div class="row">
            <div class="col-6 mb-3">
                <label asp-for="StartTime">Start time (UTC)</label>
                <input asp-for="StartTime" type="datetime-local" class="form-control" />
            </div>
            <div class="col-6 mb-3">
                <label asp-for="Status">Status</label>
                <select asp-for="Status" class="form-control">
                    <option value="upcoming">Upcoming</option>
                    <option value="live">Live</option>
                    <option value="replay">Replay</option>
                </select>
            </div>
        </div>
        <div class="mb-3">
            <label asp-for="SourceUrl">Stream / match link (optional)</label>
            <input asp-for="SourceUrl" class="form-control" placeholder="https://..." />
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-danger" type="submit">Create</button>
            <a class="btn btn-outline-light" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

