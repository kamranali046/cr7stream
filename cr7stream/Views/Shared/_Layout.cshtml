    <meta property="og:description" content="@(ViewData["MetaDescription"] ?? "Watch CR7Stream HD live sports streams - Football, UFC, Boxing, F1, NBA, NFL, NHL. No signup, instant access.")" />
    <meta name="twitter:card" content="summary" />
    <link rel="canonical" href="https://cr7stream.com/" />
    <link rel="icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon-16x16.png" />
