@model List<cr7stream.Models.AdminCategoryViewModel>
@{
    ViewData["Title"] = "Admin Dashboard";
    var sourceUrl = (string?)ViewData["SourceUrl"] ?? "https://total-sportek.st/";
    var dailyScrapeTime = (string?)ViewData["DailyScrapeTime"] ?? "09:00";
    var lastScraped = ViewData["LastScraped"] as DateTime?;
}

@if (!string.IsNullOrEmpty(TempData["ScrapeMessage"] as string))
{
    <div class="admin-card" style="border-color:var(--ok,#22c55e);">@TempData["ScrapeMessage"]</div>
}
@if (!string.IsNullOrEmpty(TempData["ScrapeError"] as string))
{
    <div class="admin-card" style="border-color:#ef4444;">@TempData["ScrapeError"]</div>
}

<div class="admin-card">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h3 class="mb-1">Scraper Settings</h3>
            <div class="cat-meta mb-1">
                <strong>Source:</strong> <a href="@sourceUrl" target="_blank" style="color:var(--accent);">@sourceUrl</a>
                <span class="mx-2">·</span>
                <strong>Auto-scrape:</strong> daily at @dailyScrapeTime
                <span class="mx-2">·</span>
                <strong>Last scraped:</strong> @(lastScraped.HasValue ? lastScraped.Value.AddHours(5).ToString("dd-MMM-yyyy HH:mm", System.Globalization.CultureInfo.InvariantCulture) + " PKT" : "never")
            </div>
        </div>
        <a class="btn btn-sm btn-outline-light" asp-action="Settings">Edit settings</a>
    </div>
</div>

    <div class="d-flex align-items-center justify-content-end mb-3">
        <div class="d-flex gap-2" style="align-items:center;">
            <button type="button" class="btn btn-sm btn-outline-light" onclick="document.getElementById('adjustTimeBox').style.display=document.getElementById('adjustTimeBox').style.display==='none'?'flex':'none'" title="Adjust all match times">&#9200; Adjust Time</button>
            <div id="adjustTimeBox" style="display:none;align-items:center;gap:6px;background:var(--surface-2);padding:6px 10px;border-radius:8px;border:1px solid var(--border);">
                <span style="color:var(--muted);font-size:13px;">Subtract</span>
                <input type="number" id="adjustMinutes" min="1" max="1440" value="5" class="form-control form-control-sm" style="width:60px;" />
                <span style="color:var(--muted);font-size:13px;">min</span>
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="document.getElementById('adjustHiddenMinutes').value=document.getElementById('adjustMinutes').value;document.getElementById('adjustTimeForm').submit();">&#10003;</button>
                <button type="button" class="btn btn-sm btn-outline-light" onclick="this.parentElement.style.display='none'">&#10005;</button>
            </div>
            <form asp-action="AdjustAllTimes" method="post" id="adjustTimeForm" class="d-none">
                <input type="hidden" name="minutes" id="adjustHiddenMinutes" />
            </form>
            <a class="btn btn-sm btn-outline-light" asp-action="CategoryCreate">+ Add Category</a>
            <form asp-action="Scrape" method="post">
                <button class="btn btn-sm btn-warning" type="submit">Re-scrape now</button>
            </form>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="admin-card">No categories yet. Click <strong>Add Category</strong> to create one.</div>
}

@foreach (var category in Model)
{
    <div class="admin-card @(category.League.Hidden ? "opacity-50" : "")">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2" style="background:var(--surface-2);margin:-16px -16px 12px;padding:12px 16px;border-radius:12px 12px 0 0;">
            <div style="display:flex;align-items:center;gap:10px;">
                @if (!string.IsNullOrEmpty(category.League.Logo))
                {
                    <img src="@category.League.Logo" alt="" width="32" height="32" style="border-radius:6px;object-fit:cover;" onerror="this.style.display='none'" />
                }
                <h3>
                    @category.League.Name
                    @if (category.League.Hidden)
                    {
                        <span class="admin-badge replay">hidden</span>
                    }
                </h3>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <form asp-action="MoveCategory" asp-route-slug="@category.League.Slug" method="post">
                    <input type="hidden" name="direction" value="up" />
                    <button class="btn btn-sm btn-outline-light" type="submit" title="Move up">&#9650;</button>
                </form>
                <form asp-action="MoveCategory" asp-route-slug="@category.League.Slug" method="post">
                    <input type="hidden" name="direction" value="down" />
                    <button class="btn btn-sm btn-outline-light" type="submit" title="Move down">&#9660;</button>
                </form>
                <form asp-action="ToggleCategoryHidden" asp-route-slug="@category.League.Slug" method="post">
                    <button class="btn btn-sm btn-outline-light" type="submit">@(category.League.Hidden ? "Show" : "Hide")</button>
                </form>
                <a class="btn btn-sm btn-outline-light" asp-action="MatchCreate" asp-route-categorySlug="@category.League.Slug">+ Add Match</a>
                <form asp-action="CategoryDelete" asp-route-slug="@category.League.Slug" method="post" onsubmit="return confirm('Delete category and all its matches?');">
                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete">&#128465;</button>
                </form>
            </div>
        </div>

        @if (category.Matches.Count == 0)
        {
            <p class="mt-3 mb-0" style="color:var(--muted);">No matches in this category.</p>
        }
        else
        {
            <table class="admin-table mt-2">
                <thead>
                    <tr>
                        <th>Match</th>
                        <th>Time</th>
                        <th>Live</th>
                        <th>Ended</th>
                        <th>Players</th>
                        <th>Scrape</th>
                        <th>Manage</th>
                        <th class="text-center">Delete</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var match in category.Matches)
                    {
                        var live = match.IsLive;
                        var ended = match.IsEnded || match.Status == "replay";
                        <tr>
                            <td>
                                <a href="https://www.google.com/search?q=@(Uri.EscapeDataString(match.HomeTeam + " vs " + match.AwayTeam))" target="_blank" style="color:var(--text);">
                                    @match.HomeTeam
                                    <span style="color:var(--muted);"> vs </span>
                                    @match.AwayTeam
                                </a>
                                @if (match.Important) { <span class="admin-badge important">&#9733;</span> }
                            </td>
                            <td class="time-cell">
                                <span class="time-text">@match.StartTimeUtc.AddHours(5).ToString("dd-MMM-yyyy hh:mm tt", System.Globalization.CultureInfo.InvariantCulture)</span>
                                <form asp-action="UpdateMatchTime" asp-route-slug="@match.Slug" method="post" class="time-edit-form" style="display:none;">
                                    <input type="datetime-local" name="startTime" value="@match.StartTimeUtc.AddHours(5).ToString("yyyy-MM-ddTHH:mm")" class="form-control form-control-sm" style="width:auto;" />
                                    <button type="submit" class="btn btn-sm btn-outline-light" title="Save">&#10003;</button>
                                    <button type="button" class="btn btn-sm btn-outline-light" title="Cancel" onclick="this.closest('.time-edit-form').style.display='none';this.closest('.time-cell').querySelector('.time-text').style.display='';this.closest('.time-cell').querySelector('.edit-icon').style.display='';">&#10005;</button>
                                </form>
                                <span class="edit-icon" onclick="this.style.display='none';this.closest('.time-cell').querySelector('.time-text').style.display='none';this.closest('.time-cell').querySelector('.time-edit-form').style.display='flex';" title="Edit time" style="cursor:pointer;color:var(--muted);margin-left:4px;">&#9998;</span>
                            </td>
                            <td>
                                <form asp-action="ToggleMatchLive" asp-route-slug="@match.Slug" method="post" class="d-inline">
                                    <label class="tick"><input type="checkbox" @(live ? "checked" : "") onchange="this.form.submit()" /></label>
                                </form>
                            </td>
                            <td>
                                <form asp-action="ToggleMatchEnded" asp-route-slug="@match.Slug" method="post" class="d-inline">
                                    <label class="tick"><input type="checkbox" @(ended ? "checked" : "") onchange="this.form.submit()" /></label>
                                </form>
                            </td>
                            <td>@match.Players.Count</td>
                            <td class="text-center">
                                <form asp-action="RefreshPlayers" asp-route-slug="@match.Slug" method="post">
                                    <button class="btn btn-sm btn-outline-light" type="submit" title="Scrape players from source">&#8635;</button>
                                </form>
                            </td>
                            <td>
                                <div class="d-flex gap-1 flex-wrap">
                                    <a class="btn btn-sm btn-outline-light" asp-action="MatchDetails" asp-route-slug="@match.Slug">Players</a>
                                    <form asp-action="ToggleImportant" asp-route-slug="@match.Slug" method="post">
                                        <button class="btn btn-sm btn-outline-light" type="submit" title="Important">&#9733;</button>
                                    </form>
                                    <form asp-action="MoveMatch" asp-route-slug="@match.Slug" method="post">
                                        <input type="hidden" name="direction" value="up" />
                                        <button class="btn btn-sm btn-outline-light" type="submit" title="Move up">&#9650;</button>
                                    </form>
                                    <form asp-action="MoveMatch" asp-route-slug="@match.Slug" method="post">
                                        <input type="hidden" name="direction" value="down" />
                                        <button class="btn btn-sm btn-outline-light" type="submit" title="Move down">&#9660;</button>
                                    </form>
                                </div>
                            </td>
                            <td class="text-center">
                                <form asp-action="MatchDelete" asp-route-categorySlug="@category.League.Slug" asp-route-matchSlug="@match.Slug" method="post" onsubmit="return confirm('Delete this match?');">
                                    <button class="btn btn-sm btn-outline-danger" type="submit" title="Delete">&#128465;</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

